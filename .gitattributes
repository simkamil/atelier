* text=auto eol=lf
*.bin binary
*.out binary
*.zip binary
*.font binary
*.ttc binary
*.ttf binary
*.png binary
*.gif binary
*.bmp binary
# Keep malformed encodings and XML EOL-normalization fixtures byte-exact.
/tests/format-reference/** -text -whitespace
# This negative fixture is deliberately not decodable as UTF-8.
/tests/format-reference/xml/malformed-truncated-utf8.xml -diff
*.rgba binary
*.tgz binary
*.lib binary
*.wasm binary
# Retain the Microsoft SDK oracle and license byte for byte.
/data/webview2/** -text -whitespace
/data/webview2/include/WebView2.h -diff
# Preserve whitespace in original upstream license notices and corpus notes.
/data/fonts/licenses/*.txt whitespace=-blank-at-eol,-blank-at-eof
/tests/image-reference/pngsuite/PngSuite.LICENSE whitespace=-blank-at-eof
/tests/image-reference/pngsuite/PngSuite.README -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Keep official UCD source files byte-exact, including upstream whitespace.
/data/ucd/** -text -whitespace
# Empty glyphs have an explicit empty last TSV column. Preserve oracle bytes.
/tests/font-outline-reference/** -text -whitespace
/tests/unicode-reference/** -text -whitespace
/tests/font-layout-reference/** -text -whitespace
/tests/font-layout-reference/layout.tsv -diff
